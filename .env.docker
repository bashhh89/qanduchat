# Docker Environment Config

# App Title
APP_TITLE=QanDu Chat

# Host and Port for the server
HOST=0.0.0.0
PORT=3080

# Domain settings
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# MongoDB connection string
MONGO_URI=mongodb://mongodb:27017/LibreChat

# API Endpoints
ENDPOINTS=custom,openAI,agents

# Sandpack bundler URL - use localhost for browser access
SANDPACK_BUNDLER_URL=http://localhost:8080

# Debug settings
DEBUG_LOGGING=true
DEBUG_CONSOLE=true

# Explicitly define permissions for agents
ALLOW_AGENTS=true

